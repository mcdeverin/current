{
  "name": "MoodLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "date": {
      "type": "string",
      "description": "YYYY-MM-DD local date"
    },
    "value": {
      "type": "number",
      "description": "Mood value 0-4 (0=struggling, 4=good)"
    },
    "note": {
      "type": "string",
      "description": "Optional note"
    },
    "created_at": {
      "type": "string",
      "description": "ISO8601 timestamp"
    }
  },
  "required": [
    "user_email",
    "date",
    "value"
  ]
}