{
  "name": "PlacesLA",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the place"
    },
    "type": {
      "type": "string",
      "enum": [
        "Spots",
        "Mocktails",
        "Events",
        "Caf\u00e9s",
        "Wellness"
      ],
      "description": "Category of the place"
    },
    "neighborhood": {
      "type": "string",
      "description": "Neighborhood or area"
    },
    "address": {
      "type": "string"
    },
    "tag": {
      "type": "string",
      "enum": [
        "Alcohol-Free",
        "NA Cocktails",
        "NA Wine",
        "NA Bottle Shop",
        "Sober Rave",
        "Sober Event",
        "Sober Friendly"
      ]
    },
    "vibe": {
      "type": "string",
      "enum": [
        "Chill",
        "Lively",
        "Romantic",
        "Social",
        "Cozy",
        "Trendy",
        "Wellness"
      ]
    },
    "price_level": {
      "type": "string",
      "enum": [
        "$",
        "$$",
        "$$$",
        "$$$$"
      ]
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "profile_image": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "Hero photo URL"
    },
    "photo_credit": {
      "type": "string",
      "description": "Photo credit line"
    },
    "description": {
      "type": "string"
    },
    "google_maps_url": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "instagram_url": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "monday_open": {
      "type": "string"
    },
    "monday_close": {
      "type": "string"
    },
    "tuesday_open": {
      "type": "string"
    },
    "tuesday_close": {
      "type": "string"
    },
    "wednesday_open": {
      "type": "string"
    },
    "wednesday_close": {
      "type": "string"
    },
    "thursday_open": {
      "type": "string"
    },
    "thursday_close": {
      "type": "string"
    },
    "friday_open": {
      "type": "string"
    },
    "friday_close": {
      "type": "string"
    },
    "saturday_open": {
      "type": "string"
    },
    "saturday_close": {
      "type": "string"
    },
    "sunday_open": {
      "type": "string"
    },
    "sunday_close": {
      "type": "string"
    },
    "suggested_by": {
      "type": "string"
    },
    "suggested_by_name": {
      "type": "string"
    },
    "suggested_by_days": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined"
      ],
      "default": "pending"
    }
  },
  "required": [
    "name",
    "type",
    "neighborhood"
  ]
}