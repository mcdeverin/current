{
  "name": "Letter",
  "type": "object",
  "properties": {
    "body": {
      "type": "string",
      "description": "Letter body, max 280 chars"
    },
    "author_day": {
      "type": "number",
      "description": "Day count at time of writing (anonymous)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Moderation status"
    },
    "created_at": {
      "type": "string",
      "description": "ISO8601 timestamp"
    },
    "delivered_count": {
      "type": "number",
      "default": 0,
      "description": "How many times this letter has been shown"
    }
  },
  "required": [
    "body"
  ]
}