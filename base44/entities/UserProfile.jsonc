{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "User's first name"
    },
    "sobriety_date": {
      "type": "string",
      "format": "date",
      "description": "The date the user started their journey (optional)"
    },
    "mode": {
      "type": "string",
      "enum": [
        "streak",
        "exploring"
      ],
      "default": "streak",
      "description": "Whether user is tracking a streak or just exploring"
    },
    "daily_savings_rate": {
      "type": "number",
      "default": 15,
      "description": "Amount saved per day in dollars"
    },
    "notification_time": {
      "type": "string",
      "default": "08:00",
      "description": "Preferred time for daily intention notification"
    },
    "why_i_started": {
      "type": "string",
      "description": "Private text about why they started - never shown publicly"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed onboarding"
    },
    "has_seen_tone_guide": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has seen the community tone guide"
    },
    "exploring_nudge_dismissed": {
      "type": "boolean",
      "default": false,
      "description": "Whether exploring user has dismissed the date nudge"
    },
    "anchor_contact_name": {
      "type": "string",
      "description": "Name of the anchor contact, e.g. Mom, Jamie"
    },
    "anchor_contact_phone": {
      "type": "string",
      "description": "Phone number of the anchor contact"
    },
    "pause_start": {
      "type": "string",
      "description": "YYYY-MM-DD date when pause started"
    },
    "pause_end": {
      "type": "string",
      "description": "YYYY-MM-DD date when pause ends, null = open-ended"
    },
    "pause_reason": {
      "type": "string",
      "description": "Reason for pausing: travel, illness, or custom"
    },
    "budget_goal_label": {
      "type": "string",
      "description": "Goal label, e.g. A week in Lisbon"
    },
    "budget_goal_amount": {
      "type": "number",
      "description": "Goal amount in dollars"
    },
    "quiet_hours_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether quiet hours are enabled"
    },
    "quiet_start": {
      "type": "string",
      "default": "22:00",
      "description": "Quiet hours start time HH:MM"
    },
    "quiet_end": {
      "type": "string",
      "default": "06:00",
      "description": "Quiet hours end time HH:MM"
    }
  },
  "required": [
    "first_name"
  ]
}