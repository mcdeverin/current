{
  "name": "DailyContent",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "article",
        "tip",
        "story",
        "reflection"
      ],
      "description": "Type of daily content"
    },
    "text": {
      "type": "string",
      "description": "Main content text"
    },
    "category": {
      "type": "string",
      "description": "Content category or tag"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this content is active"
    }
  },
  "required": [
    "type",
    "text",
    "category"
  ]
}