{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "User's first name"
    },
    "sobriety_date": {
      "type": "string",
      "format": "date",
      "description": "The date the user started their sobriety (optional)"
    },
    "mode": {
      "type": "string",
      "enum": [
        "streak",
        "exploring"
      ],
      "default": "streak",
      "description": "Whether user is tracking a streak or just exploring"
    },
    "daily_savings_rate": {
      "type": "number",
      "default": 15,
      "description": "Amount saved per day in dollars"
    },
    "notification_time": {
      "type": "string",
      "default": "08:00",
      "description": "Preferred time for daily intention notification"
    },
    "why_i_started": {
      "type": "string",
      "description": "Private text about why they started - never shown publicly"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed onboarding"
    },
    "has_seen_tone_guide": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has seen the community tone guide"
    },
    "exploring_nudge_dismissed": {
      "type": "boolean",
      "default": false,
      "description": "Whether exploring user has dismissed the date nudge"
    },
    "emergency_contact_name": {
      "type": "string",
      "description": "Name of emergency contact for Anchor feature"
    },
    "emergency_contact_phone": {
      "type": "string",
      "description": "Phone number of emergency contact for Anchor feature"
    },
    "anchor_activity": {
      "type": "string",
      "description": "Optional third Anchor button activity"
    },
    "savings_goal_label": {
      "type": "string",
      "default": "A week in Lisbon",
      "description": "Label for the savings goal"
    },
    "savings_goal_amount": {
      "type": "number",
      "default": 5000,
      "description": "Target savings goal in dollars"
    },
    "quiet_hours_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether quiet hours are enabled"
    },
    "quiet_start": {
      "type": "string",
      "default": "22:00",
      "description": "Quiet hours start time HH:MM"
    },
    "quiet_end": {
      "type": "string",
      "default": "06:00",
      "description": "Quiet hours end time HH:MM"
    },
    "paused": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has paused their streak"
    },
    "pause_until": {
      "type": "string",
      "format": "date",
      "description": "Date until which the streak is paused"
    },
    "reflection_push_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether evening reflection push notifications are enabled"
    },
    "letters_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether daily letters feature is enabled"
    },
    "anchor_button_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the floating Anchor button is visible"
    }
  },
  "required": [
    "first_name"
  ]
}