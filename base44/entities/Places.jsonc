{
  "name": "Places",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the place"
    },
    "type": {
      "type": "string",
      "enum": [
        "Spots",
        "Mocktails",
        "Events",
        "Caf\u00e9s",
        "Wellness"
      ],
      "description": "Category of the place"
    },
    "neighborhood": {
      "type": "string",
      "description": "Neighborhood or area"
    },
    "borough": {
      "type": "string",
      "enum": [
        "Manhattan",
        "Brooklyn",
        "Queens",
        "The Bronx",
        "Staten Island"
      ],
      "description": "NYC borough"
    },
    "city": {
      "type": "string",
      "description": "City name"
    },
    "address": {
      "type": "string",
      "description": "Street address"
    },
    "tag": {
      "type": "string",
      "enum": [
        "Alcohol-Free",
        "NA Cocktails",
        "NA Wine",
        "NA Bottle Shop",
        "Sober Rave",
        "Sober Event",
        "Sober Friendly"
      ],
      "description": "Primary tag"
    },
    "vibe": {
      "type": "string",
      "enum": [
        "Chill",
        "Lively",
        "Romantic",
        "Social",
        "Cozy",
        "Trendy",
        "Wellness"
      ],
      "description": "Vibe of the place"
    },
    "price_level": {
      "type": "string",
      "enum": [
        "$",
        "$$",
        "$$$",
        "$$$$"
      ],
      "description": "Price level"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether this place is featured/highlighted"
    },
    "profile_image": {
      "type": "string",
      "description": "Profile image URL for the place"
    },
    "description": {
      "type": "string",
      "description": "Short note about the place"
    },
    "google_maps_url": {
      "type": "string",
      "description": "Google Maps link"
    },
    "website_url": {
      "type": "string",
      "description": "Website URL"
    },
    "instagram_url": {
      "type": "string",
      "description": "Instagram profile URL"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "monday_open": {
      "type": "string",
      "description": "Opening time Monday HH:MM 24h"
    },
    "monday_close": {
      "type": "string",
      "description": "Closing time Monday HH:MM 24h"
    },
    "tuesday_open": {
      "type": "string",
      "description": "Opening time Tuesday HH:MM 24h"
    },
    "tuesday_close": {
      "type": "string",
      "description": "Closing time Tuesday HH:MM 24h"
    },
    "wednesday_open": {
      "type": "string",
      "description": "Opening time Wednesday HH:MM 24h"
    },
    "wednesday_close": {
      "type": "string",
      "description": "Closing time Wednesday HH:MM 24h"
    },
    "thursday_open": {
      "type": "string",
      "description": "Opening time Thursday HH:MM 24h"
    },
    "thursday_close": {
      "type": "string",
      "description": "Closing time Thursday HH:MM 24h"
    },
    "friday_open": {
      "type": "string",
      "description": "Opening time Friday HH:MM 24h"
    },
    "friday_close": {
      "type": "string",
      "description": "Closing time Friday HH:MM 24h"
    },
    "saturday_open": {
      "type": "string",
      "description": "Opening time Saturday HH:MM 24h"
    },
    "saturday_close": {
      "type": "string",
      "description": "Closing time Saturday HH:MM 24h"
    },
    "sunday_open": {
      "type": "string",
      "description": "Opening time Sunday HH:MM 24h"
    },
    "sunday_close": {
      "type": "string",
      "description": "Closing time Sunday HH:MM 24h"
    },
    "suggested_by": {
      "type": "string",
      "description": "Email of user who suggested"
    },
    "suggested_by_name": {
      "type": "string",
      "description": "First name of user who suggested"
    },
    "suggested_by_days": {
      "type": "number",
      "description": "Days sober when suggestion was made"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined"
      ],
      "default": "pending",
      "description": "Review status of the place"
    }
  },
  "required": [
    "name",
    "type",
    "neighborhood"
  ]
}